class alunos:

    def __init__(self,notas):
        self._notas = notas
    
    def calcular_media(self):
        media = sum(self._notas)/len(self._notas)
        
        if media >= 7:
            return 'Aprovado'
        else:
            return 'Reprovado', media


notas = [5.5,5.5,0,4]
meu_aluno = alunos(notas)
resultado = meu_aluno.calcular_media()
print(resultado)