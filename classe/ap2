# Criando um Personagem de Videogame, vai receber dano
# e recuperar vida
import random
class Mundo_Escolhas:

    def __init__(self, nome_personagem, dinheiro = 0):
        
        self._nome_peronagem = nome_personagem
        self._vida = 100
        self._dinheiro = dinheiro

    @property
    def nome(self):
        return self._nome_peronagem

        # Set para trocar de nome
    def set_TrocarNome(self, novo_nome):
        self._nome_peronagem = novo_nome

    # Get para apenas visualizar 
    @property
    def dinheiro(self):
        return self._dinheiro

        # Set para adicionar de dinheiro
    def ganhou_dinheiro(self, novo_dinheiro):
        self._dinheiro = self._dinheiro + novo_dinheiro

        # Set para remover de dinheiro
    def perdeu_dinheiro(self, novo_dinheiro):
        self._dinheiro = self._dinheiro - novo_dinheiro

    # Get
    @property
    def vida(self):
        return self._vida

    # Set para recuperar a vida
    def set_RecuperarVida(self, nova_vida):
        if nova_vida > 0:
                    self._vida = self._vida + nova_vida
        else:
            print('A nova vida tem que ser positiva (acima de 0)')

    
    def sofrer_dano(self, quantidade):

        self._vida = self._vida - quantidade

        if self._vida < 0:
            self._vida = 0
    
        return (f'{self._vida}')


# Pergunta o nome do seu personagem
