# Criando um Personagem de Videogame, vai receber dano
# e recuperar vida

import random

class Mundo_Escolhas:

    def __init__(self, nome_personagem):
        
        self._nome_peronagem = nome_personagem
        self._vida = 100

    @property
    def nome(self):
        return self._nome_peronagem

        # Set para trocar de nome
    def trocar_nome(self, novo_nome):
        self._nome_peronagem = novo_nome

    # Get
    @property
    def vida(self):
        return self._vida

    # Set para recuperar a vida
    def recuperar_vida(self, nova_vida):
        if nova_vida > 0:
                    self._vida = self._vida + nova_vida
        else:
            print('A nova vida tem que ser positiva (acima de 0)')

    
    def sofrer_dano(self, quantidade):

        self._vida = self._vida - quantidade

        if self._vida < 0:
            self._vida = 0
    
        return (f'{self._vida}')


